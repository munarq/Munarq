<script>
    // 1. Theme Toggle Logic
    const themeToggleBtn = document.getElementById('theme-toggle');
    const html = document.documentElement;

    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        html.classList.add('dark');
        themeToggleBtn.textContent = '[ Light Mode ]';
    } else {
        html.classList.remove('dark');
        themeToggleBtn.textContent = '[ Dark Mode ]';
    }

    themeToggleBtn.addEventListener('click', () => {
        html.classList.toggle('dark');
        if (html.classList.contains('dark')) {
            localStorage.theme = 'dark';
            themeToggleBtn.textContent = '[ Light Mode ]';
            updateSVGColors(true);
        } else {
            localStorage.theme = 'light';
            themeToggleBtn.textContent = '[ Dark Mode ]';
            updateSVGColors(false);
        }
    });

    function updateSVGColors(isDark) {
        const svgElements = document.querySelectorAll('#structural-svg polygon, #structural-svg line');
        const strokeColor = isDark ? '#F5F5F5' : '#1A1A1A';
        svgElements.forEach(el => {
            if (el.tagName === 'polygon') el.setAttribute('fill', strokeColor);
            if (el.tagName === 'line') el.setAttribute('stroke', strokeColor);
        });
    }

    // 2. Mobile Menu Logic
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    let isMenuOpen = false;

    function toggleMenu() {
        isMenuOpen = !isMenuOpen;
        if (isMenuOpen) {
            mobileMenu.classList.remove('hidden');
            // Small delay to allow display:flex to apply before opacity transition
            setTimeout(() => mobileMenu.classList.remove('opacity-0'), 10);
            // Animate hamburger to X
            mobileMenuBtn.children[0].classList.add('rotate-45', 'translate-y-[3.5px]');
            mobileMenuBtn.children[1].classList.add('-rotate-45', '-translate-y-[3.5px]');
        } else {
            mobileMenu.classList.add('opacity-0');
            setTimeout(() => mobileMenu.classList.add('hidden'), 300);
            // Animate X back to hamburger
            mobileMenuBtn.children[0].classList.remove('rotate-45', 'translate-y-[3.5px]');
            mobileMenuBtn.children[1].classList.remove('-rotate-45', '-translate-y-[3.5px]');
        }
    }

    mobileMenuBtn.addEventListener('click', toggleMenu);
    mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));

    // 3. Calculator Logic
    const spanSlider = document.getElementById('span-slider');
    const loadSlider = document.getElementById('load-slider');
    const spanVal = document.getElementById('span-val');
    const loadVal = document.getElementById('load-val');
    const outputDepth = document.getElementById('output-depth');
    const outputCO2 = document.getElementById('output-co2');
    const diagramDeflection = document.getElementById('diagram-deflection');
    const deflectionCurve = document.getElementById('deflection-curve');
    const deflectionPin = document.getElementById('deflection-pin');
    const complianceBadge = document.getElementById('compliance-badge');
    const matButtons = document.querySelectorAll('.mat-select-btn');

    let currentMaterial = 'geopolymer';

    matButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            matButtons.forEach(b => {
                b.classList.remove('bg-onyx', 'text-pure', 'dark:bg-pure', 'dark:text-onyx');
                b.classList.add('bg-transparent', 'text-onyx', 'dark:text-pure');
            });
            btn.classList.add('bg-onyx', 'text-pure', 'dark:bg-pure', 'dark:text-onyx');
            btn.classList.remove('bg-transparent', 'text-onyx', 'dark:text-pure');
            
            currentMaterial = btn.getAttribute('data-material');
            recalculate();
        });
    });

    function recalculate() {
        const span = parseFloat(spanSlider.value);
        const load = parseFloat(loadSlider.value);

        spanVal.textContent = span.toFixed(1) + ' m';
        loadVal.textContent = load.toFixed(1) + ' kN/m²';

        let ratio = 17.5;
        let co2Base = -2.7;
        let elasticMod = 1.0;

        if (currentMaterial === 'timber') {
            ratio = 14.0;
            co2Base = -5.8;
            elasticMod = 0.85;
        } else if (currentMaterial === 'portland') {
            ratio = 20.0;
            co2Base = 18.5;
            elasticMod = 1.35;
        }

        const calculatedDepth = Math.round((span / ratio) * 1000);
        outputDepth.innerHTML = calculatedDepth + ' <span class="text-2xl">mm</span>';

        const netCO2 = (span * co2Base * (load / 4.0)).toFixed(1);
        if (netCO2 < 0) {
            outputCO2.textContent = netCO2;
            outputCO2.className = 'font-serif text-5xl font-light text-moss dark:text-[#8ba83b]';
        } else {
            outputCO2.textContent = '+' + netCO2;
            outputCO2.className = 'font-serif text-5xl font-light text-[#ba1a1a]'; 
        }

        const deflectionMM = ((Math.pow(span, 3) * load * 0.019) / elasticMod).toFixed(1);
        const limitL500 = ((span * 1000) / 500).toFixed(1);

        if (parseFloat(deflectionMM) <= parseFloat(limitL500)) {
            diagramDeflection.textContent = `f_max: ${deflectionMM} mm (L/500)`;
            complianceBadge.textContent = `✓ Compliant`;
            complianceBadge.className = 'font-mono text-[10px] uppercase tracking-wider text-moss dark:text-[#8ba83b] font-bold border border-moss/30 dark:border-[#8ba83b]/30 px-2 py-1 bg-moss/5 dark:bg-[#8ba83b]/5';
            deflectionCurve.setAttribute('stroke', '#61752D');
            deflectionPin.setAttribute('fill', '#61752D');
        } else {
            diagramDeflection.textContent = `f_max: ${deflectionMM} mm (Excessive)`;
            complianceBadge.textContent = `⚠ Expansion Req.`;
            complianceBadge.className = 'font-mono text-[10px] uppercase tracking-wider text-[#ba1a1a] font-bold border border-[#ba1a1a]/30 px-2 py-1 bg-[#ba1a1a]/5';
            deflectionCurve.setAttribute('stroke', '#ba1a1a');
            deflectionPin.setAttribute('fill', '#ba1a1a');
        }

        const baselineY = 50;
        const maxSag = Math.min(85, baselineY + (deflectionMM * 1.6));
        deflectionCurve.setAttribute('d', `M 20 ${baselineY} Q 200 ${maxSag} 380 ${baselineY}`);
        deflectionPin.setAttribute('cy', maxSag);
    }

    spanSlider.addEventListener('input', recalculate);
    loadSlider.addEventListener('input', recalculate);

    // 4. Scroll Reveal Animations
    const revealElements = document.querySelectorAll('.reveal');

    const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
                observer.unobserve(entry.target); // Only animate once
            }
        });
    }, {
        root: null,
        threshold: 0.1, // Trigger when 10% of the element is visible
        rootMargin: "0px 0px -50px 0px" // Slight offset so it triggers a bit before entering view
    });

    revealElements.forEach(el => revealObserver.observe(el));

    // Init
    updateSVGColors(html.classList.contains('dark'));
</script>
</body>
</html>
