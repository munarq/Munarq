# GEMINI_API_KEY: Required for Gemini AI API calls.
# If absent, /api/analyze degrades gracefully to a deterministic fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Express API port. Vite dev proxies /api → :3001 automatically.
PORT="3001"
